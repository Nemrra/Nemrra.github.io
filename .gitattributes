# Normalise line endings to LF in the repo for all text files
* text=auto eol=lf

# Treat binary assets as binary (no diff, no line-ending conversion)
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp4   binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
